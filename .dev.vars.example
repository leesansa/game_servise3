# 로컬 개발용 비밀값 예시. 이 파일을 .dev.vars 로 복사해서 값을 채운다 (.dev.vars 는 커밋하지 않음)
# AUTH_SECRET 은 아무 긴 임의 문자열: npx auth secret 또는 openssl rand -base64 32
AUTH_SECRET=
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키(REST API 키) / 카카오 로그인 > 보안(Client Secret)
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
