{
  "name": "mycar-note",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@vinext/cloudflare": "^1.5.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "typescript": "^6.0.3",
    "vite": "8.3.0",
    "vitest": "^5.1.2"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "preview": "npm run build && npm run start --",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "cf-typegen": "cf workers types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "cf d1 migrations apply 739d8b81-effa-4a37-b573-c29580f5142b --local --dir src/server/db/migrations",
    "db:migrate:remote": "cf d1 migrations apply 739d8b81-effa-4a37-b573-c29580f5142b --dir src/server/db/migrations"
  }
}
